/*
 * DIAGNOSTIC, paired with overlay-uartcon.conf.
 *
 * The board's default console is the USB CDC ACM instance
 * (zephyr/boards/common/usb/cdc_acm_serial.dtsi), which cannot testify about
 * a boot that dies before USB exists. Re-point it at uart0, whose TX reaches
 * the dongle's UART pads and a USB-to-serial adapter at 115200.
 */
/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};
};
