# The reader identity used to arrive here as a build-time string
# (CONFIG_ULTRAWIDELOCK_PROV_SEED_HEX), which put a reader private key into every image
# and made the firmware unshareable. It is now per-device data in the settings
# store, typed in over the USB console in provisioning mode, so there is
# deliberately no knob left that can put a key back into a build.

config ULTRAWIDELOCK_PROV_CONSOLE
	bool "USB CDC-ACM provisioning console (SW2 held through reset)"
	default y
	help
	  The runtime provisioning path: hold SW2 through reset and the board comes
	  up with its radios down and an `ultrawidelock` console on the nRF52833's USB port.
	  Costs 44,288 B flash and 19,648 B RAM, measured.

	  Turn it off for a build that gets its identity some other way -- a Matter
	  node self-provisions from Apple Home, which makes `ultrawidelock import`
	  redundant, and reader + console + Thread overflows RAM by 1,752 bytes on
	  this part, so the two cannot coexist.

# These follow the console option rather than sitting unconditionally in
# prj.conf, because a .conf file cannot make an assignment conditional: with
# CONFIG_SHELL=n the shell assignments become unsatisfiable and NCS aborts the
# build on the Kconfig warning. Defaults here are parsed before Kconfig.zephyr,
# so they win over the upstream ones.
if ULTRAWIDELOCK_PROV_CONSOLE

config USB_DEVICE_STACK
	default y

config USB_CDC_ACM
	default y

config USB_DEVICE_MANUFACTURER
	default "ultrawidelock"

config USB_DEVICE_PRODUCT
	default "ultrawidelock reader (provisioning)"

config SHELL
	default y

config SHELL_BACKEND_SERIAL
	default y

# A full APRV blob is 476 bytes = 952 hex characters plus the command word; the
# 256-byte default line buffer would silently truncate an import.
config SHELL_CMD_BUFF_SIZE
	default 1152

# import/erase commit through a software P-256 derive. Measured peak 2580 B, so
# the 2048 default faulted the shell thread via the MPU stack guard, which
# presents as a live USB device with a dead console rather than as a crash.
config SHELL_STACK_SIZE
	default 4096

# One import line is 577 characters; the 64-byte default is a single USB bulk
# packet and drops characters mid-paste.
config SHELL_BACKEND_SERIAL_RX_RING_BUFFER_SIZE
	default 1280

endif # ULTRAWIDELOCK_PROV_CONSOLE

config ULTRAWIDELOCK_PROV_CLEAR_ON_BOOT
	bool "Erase the stored credential identity at boot"
	default n
	help
	  Deletes the `ultrawidelock/prov` settings key before anything reads it, so the
	  board comes up on the DEV identity with no trust anchors, exactly as it
	  was before it was first provisioned.

	  The Matter path needs a way back. A board provisioned by one home keeps
	  that identity across a reflash, and on 2026-08-02 a re-added accessory
	  was observed getting neither SetAliroReaderConfig nor SetCredential --
	  the stale anchor then rejected the key the phone presented, one step
	  from the grant. Whether Apple skips provisioning BECAUSE the reader
	  reports the deleted home's identity is unconfirmed; this is the knob
	  that lets the question be asked.

	  `west flash --erase` clears it too, and also destroys the SRP client
	  key, which costs up to 14 days of Thread host-name ownership.

	  It erases on EVERY boot, including the one right after Apple provisions
	  a new identity. Flash it once, then flash an image without it.

config ULTRAWIDELOCK_FACTORY_RESET_BUTTON
	bool "Factory reset when SW2 is held through reset"
	default y
	help
	  Erases the stored reader identity, every trust anchor and the Matter
	  fabrics when the sw0 alias (SW2, P0.02) is held at boot, then carries
	  on booting -- so the board comes back commissionable.

	  This is not a convenience. A commissioning that installs a fabric and
	  then times out leaves that fabric stored, the advert gate switches to
	  the credential reader payload, and the controller can neither discover the
	  node nor open a commissioning window on an accessory it has already
	  forgotten. Without this button that board needs a debugger, and a user
	  does not have one.

	  Held through reset rather than long-pressed while running: it matches
	  the provisioning console's idiom on this same button, needs no timer
	  or thread on a part already at 96% RAM, and cannot fire during a
	  walk-up. led0 blinks to confirm the hold registered.

	  OpenThread's settings are left alone, which keeps the Thread dataset
	  and the SRP client key. That used to be the whole argument, because
	  losing the key cost a 14-day name collision; f7d3160 ended that. The
	  reason now is smaller and still real: rejoining beats re-attaching.

config ULTRAWIDELOCK_MCUBOOT_RECOVERY_GESTURE
	bool "Long SW2 hold enters MCUboot serial recovery"
	depends on ULTRAWIDELOCK_DFU_RECEIVER && RETENTION_BOOT_MODE
	default y
	help
	  Keep the existing short runtime press as the application DFU-window
	  gesture. Holding the same button continuously requests MCUboot through
	  the retained boot-mode byte and warm-resets into serial recovery. This
	  removes the unconditional serial-probe delay from every ordinary boot.

config ULTRAWIDELOCK_MCUBOOT_RECOVERY_HOLD_MS
	int "MCUboot recovery hold time, milliseconds"
	depends on ULTRAWIDELOCK_MCUBOOT_RECOVERY_GESTURE
	default 5000
	range 2000 15000
	help
	  The button must still be active when this delay expires. Five seconds
	  keeps an ordinary update-window press distinct from recovery.

config ULTRAWIDELOCK_BENCH
	bool "Enable DWM3001CDK performance experiments (BENCH ONLY)"
	default n
	help
	  Master acknowledgement for configurations that trade RAM, code size,
	  radio timing, or ranging evidence to collect comparative measurements.
	  Release tooling must keep this disabled.

config ULTRAWIDELOCK_LAT_TRACE
	bool "Trace BLE-to-grant walk-up latency (BENCH ONLY)"
	depends on ULTRAWIDELOCK_BENCH
	default y
	help
	  Stamp the first occurrence of each credential, ranging and grant phase
	  and print one consolidated walk-up budget after a grant. The marks are
	  cheap stores, but the final RTT report is diagnostic output and must be
	  measured before enabling it in a release image.

config ULTRAWIDELOCK_BENCH_TOGGLE_UNLOCK
	bool "A fresh ranging session may unlock on geometry alone (BENCH ONLY)"
	depends on ULTRAWIDELOCK_BENCH
	depends on ULTRAWIDELOCK_SIDE_GATE
	default n
	help
	  Every new UWB ranging session -- which is what the Wallet UWB toggle
	  creates, and the first session after a flash -- opens a 20 s window in
	  which a clean committed OUTSIDE from the side gate unlocks without any
	  approach. Lets a stationary phone test the inside/outside rule by
	  toggling: outside unlocks, inside or unknown refuses. BENCH ONLY: iOS
	  also recreates sessions on its own schedule, so on a mounted door this
	  would let the bolt follow session churn while the owner rests outside.

config ULTRAWIDELOCK_BENCH_CRED_O2
	bool "Compile credential hot files with -O2 (BENCH ONLY)"
	depends on ULTRAWIDELOCK_BENCH
	default n
	help
	  Override the application's size optimization for the reader state machine,
	  key schedule, hash, and PSA primitive translation units. Compare latency,
	  stack high water, and flash before retaining any individual file.

config ULTRAWIDELOCK_APPROACH_NEAR_DWELL
	int "Accepted near samples required before passive grant"
	default 2
	range 1 2
	help
	  Two is the shipping evidence floor. One is a bench-only latency
	  experiment and is rejected by the DWM build unless BENCH and strict STS
	  are both enabled.

config ULTRAWIDELOCK_BLE_ADV_SLOW
	bool "Fall back to slow BLE advertising when nobody has been near"
	default n
	help
	  Advertise at the GAP fast rate (30-60 ms) for a window after boot and
	  after every disconnect, then fall back to the GAP recommended slow rate
	  (1.0-1.2 s) until something happens again.

	  This is a battery lever and it is a large one. Continuous 30-60 ms
	  connectable advertising is estimated at 220-670 uA, against 10-30 uA at
	  the slow rate -- most of a 5,000 mAh six-month budget, spent on being
	  findable at a door nobody is standing at. See docs/power-baseline.md.

	  THE COST IS FIRST-DISCOVERY LATENCY. A phone approaching a lock that has
	  been idle meets the slow rate, so it is found in about 1-3 s rather than
	  well under 1 s. Repeat approaches are fast, because a disconnect reopens
	  the window. The real fix is a wake trigger rather than a faster default;
	  the LIS2DH12 on the module runs at ~2 uA and handle-touch is a real
	  signal, but nothing wires it to this yet.

	  Default n: a mains-powered board should not pay for a battery it does not
	  have. overlay-battery.conf turns it on.

config ULTRAWIDELOCK_BLE_ADV_FAST_WINDOW_S
	int "Seconds of fast advertising after boot or a disconnect"
	default 30
	depends on ULTRAWIDELOCK_BLE_ADV_SLOW
	help
	  How long the fast rate persists once something has happened. Long enough
	  that a phone that just disconnected can reconnect without waiting on the
	  slow rate, short enough that an abandoned board settles quickly.

	  Every second here costs roughly the difference between the two rates, so
	  a window of 30 s entered a few times a day is noise, while a window of an
	  hour is most of the saving handed back.

config ULTRAWIDELOCK_STATUS_LED
	bool "Report the board's state on the four LEDs"
	default y
	help
	  D9 green is the lock (solid unlocked, one blip per 2 s locked-and-alive),
	  D12 red is attention (solid fault, 0.5 Hz needs commissioning), D11 red is
	  the phone (4 Hz ranging, 1 Hz credential session) and D10 blue is a window
	  (2 Hz update window, solid provisioning mode). src/status_led.c carries
	  the argument for each.

	  This is the only output a fielded board has. RTT needs probe-rs and the
	  exact ELF that was flashed, uart0 belongs to the J-Link OB, and the USB
	  console exists only in provisioning mode -- so with this off, a lock that
	  unlocked and a lock that hung look identical.

	  One timer and four GPIO writes eight times a second, which is why it is
	  affordable on a part with 6 KB of RAM left. Turn it off only to buy back
	  that flash.

config ULTRAWIDELOCK_STATUS_LED_HEARTBEAT
	bool "Blip the lock LED once every 2 s while locked"
	depends on ULTRAWIDELOCK_STATUS_LED
	default y
	help
	  Separates "locked" from "dead", which are the same picture without it.

	  It is also the only thing keeping the 8 Hz tick running on an idle board:
	  with every LED static the tick stops itself, so turning this off buys an
	  idle board back to the wake rate it had before, at the cost of the one
	  signal that proves the firmware is still running.

config ULTRAWIDELOCK_CIRDIAG_CAPTURE
	bool "Run the CIR capture cycle unattended, for a bench capture image"
	depends on ULTRAWIDELOCK_UWB_CIRDIAG
	help
	  Arm the CIR dump, hold it for a window, disarm it so the ring drains to
	  the console, and repeat. Forever, from boot, with no operator input.

	  THIS EXISTS BECAUSE THIS BOARD HAS NO CONSOLE INPUT. modules/ultrawidelock_uwb
	  documents the capture workflow as `ultrawidelock cir dump on`, walk up, `ultrawidelock cir
	  dump off`, and every word of that is unavailable here: RTT is output-only,
	  uart0 belongs to the J-Link OB, the USB CDC console comes up only in
	  provisioning mode (where the radio never starts), and CONFIG_ULTRAWIDELOCK_UWB_SHELL
	  is n. The one button is already spoken for -- SW2 held through reset is the
	  factory reset, and a capture image that could be made to erase an Apple
	  Home credential by a mistimed press is not a capture image worth having.
	  So the cycle runs itself.

	  FOR A CAPTURE IMAGE ONLY. The dump costs walk-up latency while armed, by
	  design and measured: see CONFIG_ULTRAWIDELOCK_UWB_CIRDIAG. Do not ship this.

	  MEASURED against the plain Matter image at the same commit and the same
	  flags: +1,720 B of flash and +6,720 B of RAM. Most of the RAM is
	  CONFIG_ULTRAWIDELOCK_UWB_CIRDIAG's 4,352 B ring, which belongs to that symbol rather
	  than this one; this adds 1,600 B of thread stack and 128 B of thread
	  object. The capture image links at 91.22% of flash and 92.56% of RAM,
	  leaving 9,756 B. Under 10 KB is fine for a bench image and is one more
	  reason not to ship it.

	  Flash it with `make flash`, never `make flash-erase`: the ranging this
	  captures needs the credential the board already holds.

if ULTRAWIDELOCK_CIRDIAG_CAPTURE

config ULTRAWIDELOCK_CIRDIAG_CAPTURE_WINDOWS
	bool "Also capture CIR windows, not just the diagnostic summary"
	default y
	help
	  y arms the windowed-CIR dump each cycle and drains the ring: the full
	  capture, 64 complex taps on every fourth Final.

	  n takes the summary only -- one `[ALAB] ev=uwb.diag` line per reception,
	  no accumulator read, no ring drain. The cycle markers still bracket each
	  labelled interval.

	  SAY n UNLESS YOU SPECIFICALLY NEED THE TAPS. Two measurements point the
	  same way. On hardware (2026-08-07) the windowed image never transmitted a
	  Response at all -- `tx0`, no range, no unlock, across three sessions --
	  while the plain image on the same board ranged 22-443 cm and unlocked
	  normally; the accumulator read is too much for this single core inside the
	  ~1836 us arm deadline. And dropping every tap-derived feature costs
	  the LOS/NLOS classifier only 0.14 accuracy
	  points (0.8625 -> 0.8611) and makes it 80 B smaller, because ~76% of the
	  discriminating power is absolute received power, which is a register
	  scalar. The four features that matter -- fp_pwr, rx_pwr, pwr_diff,
	  rxpacc -- all come from ipatovPower, ipatovF1..F3 and ipatovAccumCount.

	  Whether the summary alone stays inside the deadline is UNVERIFIED: it
	  still costs one dwt_readdiagnostics plus two STS reads per reception. If
	  ranging still stalls with this n, that is the next thing to trim.

config ULTRAWIDELOCK_CIRDIAG_CAPTURE_WINDOW_MS
	int "How long the dump stays armed per cycle, milliseconds"
	default 20000
	range 1000 600000
	help
	  The ring holds the last 16 windows and one window is taken every fourth
	  Final, so 64 ranging blocks fill it. Blocks run about 192 ms apart, so
	  roughly 12 s of continuous ranging saturates the ring and anything longer
	  keeps only the most recent 16 -- the near-door end of an approach, which is
	  the end worth having. 20 s is that with margin for a walk-up that pauses.

config ULTRAWIDELOCK_CIRDIAG_CAPTURE_IDLE_MS
	int "Quiet gap after each drain, milliseconds"
	default 3000
	range 0 60000
	help
	  Nothing is armed during this gap, so ranging runs at full speed and the
	  console is quiet. It is where you reposition between runs, and it is what
	  makes the cycle markers usable as labels: everything between one
	  `cir.cycle: armed` and its `drained` line is one capture.

config ULTRAWIDELOCK_CIRDIAG_CAPTURE_STACK
	int "Capture thread stack, bytes"
	default 1536
	help
	  The thread sleeps, toggles two flags, and calls printk from the drain.
	  1,536 B is generous for that and small enough not to matter, but this
	  project has faulted on two guessed stack sizes already, so measure it with
	  CONFIG_THREAD_ANALYZER_AUTO before trusting it.

config ULTRAWIDELOCK_CIRDIAG_CAPTURE_PRIO
	int "Capture thread priority"
	default 12
	help
	  Below the Matter work queue (10), which is itself below whatever arms the
	  DW3110 reply. The drain blocks for about 0.6 s with pacing on; nothing
	  about that may compete with a ranging deadline.

endif # ULTRAWIDELOCK_CIRDIAG_CAPTURE

config ULTRAWIDELOCK_MATTER_CLEAR_ON_BOOT
	bool "Erase the stored Matter fabrics at boot"
	depends on ULTRAWIDELOCK_MATTER_BLE
	default n
	help
	  Atomically advances the `mf2` identity epoch before it is read, so the
	  board comes up with no fabric and advertises commissionable. With no
	  administering fabric, the Home Key identity is cleared too.

	  The other half of a factory reset, and why this pair is still worth
	  preferring over `west flash --erase`: together they clear everything a
	  controller can see while leaving OpenThread's own settings alone, so
	  the board rejoins its Thread network instead of being commissioned onto
	  one.

	  THIS PARAGRAPH USED TO SAY SOMETHING STRONGER AND IT IS NO LONGER TRUE.
	  The old argument was that an erase destroys the SRP client key while
	  the host name -- the bare factory EUI-64 -- survives it, so the next
	  boot asks for a name the border router still holds under the OLD key,
	  gets OT_ERROR_DUPLICATED for up to 14 DAYS, and presents as a node that
	  attaches to Thread, never registers, and hangs the commissioner on
	  "Adding to Home" with nothing to say why. f7d3160 fixed that at the
	  source: matter_thread_port.c appends a per-lifetime suffix (SRP_HOST_ID_KEY,
	  "srp/hid") that dies in the same erase that takes the key, so a new key
	  always asks for a name nobody owns, and SRP_KEY_LEASE_S asks for a
	  1-hour key lease rather than OpenThread's 14-day default to bound any
	  collision that still happens. An erase is no longer the expensive
	  operation this text described. It still costs the reader identity and
	  every iPhone key provisioned against the board, which is reason enough
	  to reach for this pair first.

	  Same caveat as ULTRAWIDELOCK_PROV_CLEAR_ON_BOOT: it erases on EVERY boot.
	  Flash it once, then flash an image without it.

config ULTRAWIDELOCK_THREAD_GATE
	bool "Stage 0 contention gate: bring Thread up alongside the reader"
	# Still NET_L2_OPENTHREAD, but for a different reason than it used to say.
	# The old note here claimed a CONFIG_NETWORKING=n build links the Thread
	# stack with no radio under it, because the 802.15.4 driver class is gated
	# on NETWORKING (zephyr/drivers/ieee802154/Kconfig). That is no longer the
	# whole picture: standalone OpenThread gets its radio from Nordic's
	# radio_nrf5.c instead, which is exactly how the shipping image now runs.
	# What keeps this gate on the L2 is its own code -- thread_gate.c brings
	# the interface up with net_if_up(), and there is no net_if without the L2.
	# The gate has served its purpose, so it is not worth porting.
	depends on NET_L2_OPENTHREAD
	select OPENTHREAD_MANUAL_START
	default n
	help
	  Measurement only, never a shipping option. Starts OpenThread next to the
	  running reader so ranging can be measured while an 802.15.4 stack shares
	  the M4 and the 2.4 GHz radio. Commit 5b8d06b won the walk-up by cutting
	  FINAL->arm latency to 0.66 ms, and Thread lands on that margin; this
	  answers whether Matter on this board is possible at all before any Matter
	  code is written. See apps/dwm3001cdk-lock/src/thread_gate.c.

config ULTRAWIDELOCK_SRP_DIAG
	bool "Report the SRP client's state every time network data changes"
	# OPENTHREAD, not NET_L2_OPENTHREAD: this reads otSrpClient* state out of
	# matter_thread_port.c and touches no net_if, so it survived the move to
	# standalone OpenThread. It has to say so explicitly -- overlay-otlog.conf
	# sets it =y, and a `depends on` that can no longer be satisfied would have
	# turned `make build OTLOG=1` into a build with no SRP diagnostics and no
	# error to say why.
	depends on OPENTHREAD
	default n
	help
	  Diagnosis only, never shipped. Answers one question the existing logs
	  cannot: whether otSrpClientEnableAutoStartMode() ever FOUND a server.

	  A registration that is never sent looks exactly like one that was sent
	  and refused -- both leave the host and services sitting at ToAdd and
	  neither reaches srp_cb(), so the only "SRP failed" line this firmware
	  can print is one that never fires. Measured on hardware 2026-08-03:
	  three minutes as an attached child with a working OMR address, both
	  services queued at ToAdd, and OpenThread's own INFO log carrying no
	  server selection at all.

	  Auto-start picks its server out of Thread network data, so network
	  data changing is the only moment the answer can change. Prints
	  otSrpClientIsRunning(), the chosen server address and the host state
	  on each OT_CHANGED_THREAD_NETDATA. Running means the fault is after
	  server selection; not running once network data has settled means this
	  node is never offered a server -- see ports/zephyr/matter/matter_thread_port.c.

config ULTRAWIDELOCK_CASE_BENCH
	bool "Stage 0a: measure what a Matter CASE responder costs"
	depends on INIT_STACKS && THREAD_STACK_INFO
	default n
	help
	  Measurement only. Every RAM figure for a hand-written Matter node is an
	  estimate, and the one that decides the plan -- the peak of the Matter
	  thread -- cannot be read with `kernel thread stacks`, because that shows
	  threads which exist and this one does not yet. Runs the responder half of
	  CASE (ECDH, an ECDSA sign, three ECDSA verifies, two HKDFs, two AES-CCMs)
	  on a dedicated thread beside the live reader and reports the stack peak,
	  the static working set, the mbedTLS heap draw and the elapsed time.

	  P-256 is what costs stack here: no CryptoCell on this part, so PSA runs
	  on the software oberon driver and every curve operation runs on the
	  calling thread. Needs CONFIG_PSA_WANT_ALG_CCM, which the reader does not
	  otherwise enable. See apps/dwm3001cdk-lock/src/case_bench.c.

config ULTRAWIDELOCK_CASE_BENCH_PERIOD_MS
	int "Repeat the CASE round every N ms (0 = measure once and stop)"
	depends on ULTRAWIDELOCK_CASE_BENCH
	default 0
	help
	  0 measures once, which is all the sizing question needs. Non-zero turns
	  the bench into a contention test: CASE keeps running while you walk up,
	  so a real unlock has to complete against ~262 ms of P-256 per round on
	  the same core. The reader's FINAL->arm margin is 0.66 ms, so this asks
	  whether running the Matter thread at a lower priority is by itself
	  enough to keep ranging alive. Small values are harsher; 50 leaves the
	  core almost permanently busy.

config ULTRAWIDELOCK_HEAP_PROBE
	bool "Report the mbedTLS heap high-water mark"
	depends on MBEDTLS_MEMORY_DEBUG
	default n
	help
	  Measurement only. CONFIG_MBEDTLS_HEAP_SIZE is 16384 here and halving it
	  was 63% of the RAM freed for a future Matter node, so it needs a number
	  rather than an argument. The argument says the cut is safe: this build is
	  OBERON_ONLY_PSA_ENABLED with no MBEDTLS_BIGNUM_C or ECP_C compiled in, so
	  ECDH/ECDSA run in driver stack buffers and only PSA key-slot material is
	  ever mbedtls_calloc'd. That is an inference from Kconfig, which is exactly
	  the reasoning that produced the bare-OpenThread mistake, so measure it.

	  Reports at two points, because the console and the reader never run at the
	  same time: `ultrawidelock heap` in provisioning mode, covering the import path's
	  P-256 derive, and an RTT line at each unlock in run mode, covering a whole
	  walk-up. Both read a peak accumulated since boot, so the walk-up figure
	  includes BLE pairing and the credential exchange, not just the ranging.

	  Needs CONFIG_MBEDTLS_MEMORY_DEBUG=y, which is not a shipping setting.

source "Kconfig.zephyr"

config ULTRAWIDELOCK_MATTER_BLE
	bool "Matter commissioning transport: the 0xFFF6 GATT service over BTP"
	# The framing itself is in modules/ultrawidelock_matter and has no Zephyr
	# dependency; this brings in the Zephyr-side adapter that carries it.
	depends on BT_PERIPHERAL
	select ULTRAWIDELOCK_MATTER
	default n
	help
	  Compile the 0xFFF6 service (C1 write, C2 indicate) and the BTP glue
	  that turns it into a Matter message transport.

	  This does not start advertising. The reader owns the single advertising
	  set, and asks for the commissionable payload only while it has no
	  identity of its own -- see ULTRAWIDELOCK_MATTER_DISCRIMINATOR.

if ULTRAWIDELOCK_MATTER_BLE

config ULTRAWIDELOCK_MATTER_DISCRIMINATOR
	hex "Matter setup discriminator, 12-bit"
	default 0xF00
	range 0x000 0xFFF
	help
	  Goes out in the commissionable advertisement, and a commissioner uses
	  it to pick this device out of everything else advertising 0xFFF6. It
	  must match the discriminator encoded in the setup code the user enters
	  or the phone will never connect.

	  0xF00 with passcode 20202021 is the pairing CHIP's own test harnesses
	  use, which makes a bench commissioner work with no extra setup.

config ULTRAWIDELOCK_MATTER_VENDOR_ID
	hex "Matter vendor ID"
	default 0xFFF1
	help
	  0xFFF1 is CHIP's test vendor. A real product needs an allocated one;
	  a phone will commission a test VID but marks the result uncertified.

config ULTRAWIDELOCK_MATTER_PRODUCT_ID
	hex "Matter product ID"
	default 0x8001

config ULTRAWIDELOCK_MATTER_SPAKE2P_VERIFIER
	string "SPAKE2+ verifier, hex: w0 (32 B) then L (65 B)"
	default "ca92f10ad437760cc8948aefe2d09f142bc1a363824a0079a63e6df097575bb5043609715ad65a53cd3c18a0f80011bf09dbbfbd9453c2b00eed286f5275ecaae60a2e896837995232334c319994d790ee2d09fe5cb4a229503234f8479eb3d308"
	help
	  What the device stores INSTEAD of the setup passcode. Someone who reads
	  this out of flash can verify a commissioner that knows the passcode and
	  cannot impersonate one, which is the point of SPAKE2+'s augmented form.

	  Generate with scripts/spake2p_verifier.py. It must be derived from the
	  same passcode, salt and iteration count as the two options below --
	  nothing on the device can check that it was, and a mismatched set fails
	  at Pake3 looking exactly like a wrong passcode.

	  The default was CHIP's own published test verifier for passcode 20202021
	  (TestOnlyCommissionableDataProvider.h:74-79). It is not any more: these
	  values are this project's own, generated once with the script above. That
	  removes the case where a stranger commissions the lock knowing nothing
	  but the SDK.

	  IT IS STILL ONE PAIRING FOR EVERY BOARD BUILT FROM THIS TREE, and a
	  binary release has to publish its setup code because nothing on the
	  device can print it. Per-board codes need per-board provisioning data,
	  which this build does not have. If the lock guards anything, generate
	  your own with the script and rebuild.

config ULTRAWIDELOCK_MATTER_SETUP_PASSCODE
	int "Setup passcode the verifier above was derived from"
	default 58490394
	range 1 134217727
	help
	  The number a user would type into Apple Home, and the ONLY symbol here
	  that no C file reads. It is not compiled in: a Kconfig value reaches the
	  image by being referenced, and nothing references this one, so the
	  passcode stays out of the firmware exactly as the augmented SPAKE2+ form
	  intends.

	  It is here because the setup code cannot be recovered from the verifier,
	  and a build that cannot say how to commission itself is a build nobody
	  can use. `make build` prints the 11-digit manual code
	  by reading this and the discriminator out of .config -- after
	  re-deriving the verifier from it and refusing to print anything if the
	  two disagree, which is the drift check the device itself cannot do.

	  Change it and CONFIG_ULTRAWIDELOCK_MATTER_SPAKE2P_VERIFIER together, both from
	  one run of scripts/spake2p_verifier.py --passcode <p>.

config ULTRAWIDELOCK_MATTER_SPAKE2P_SALT
	string "SPAKE2+ salt, hex (16 to 32 bytes)"
	default "04f7398d5b49b5b5db8a5e61c8aece1d1a230e3b9085199d854ef034fd30a89b"
	help
	  Sent to the commissioner in PBKDFParamResponse so it can repeat the
	  derivation. It was CHIP's test salt, the ASCII "SPAKE2P Key Salt"; it is
	  now 32 random bytes generated with the passcode above.

config ULTRAWIDELOCK_MATTER_SPAKE2P_ITERATIONS
	int "SPAKE2+ PBKDF2 iterations"
	default 20000
	range 1000 100000
	help
	  Also sent in PBKDFParamResponse. Costs the COMMISSIONER time, not this
	  device: the verifier is derived off-device, so a high count is paid by
	  the phone once per pairing, in milliseconds.

	  20000 rather than the 1000 floor. It raises the cost of brute-forcing
	  the passcode back out of a verifier read from flash, which matters here
	  because APPROTECT is deliberately unlocked. Be clear about how much it
	  buys, though: anyone who can dump flash can also read settings_storage,
	  where the reader private key sits in the clear, so this hardens the
	  slower of two paths. The lever that closes both is physical security.

config ULTRAWIDELOCK_MATTER_BLE_RX_BUF
	int "Inbound Matter message ceiling, bytes"
	default 1024
	help
	  Size of the BTP reassembly area, and therefore the largest message
	  this node will accept. A peer declaring more than this in its Start
	  fragment is refused before a byte is copied, so setting it low costs
	  compatibility, never memory safety.

config ULTRAWIDELOCK_MATTER_BLE_WINDOW
	int "Largest BTP receive window we will grant"
	default 4
	range 2 8

config ULTRAWIDELOCK_MATTER_BLE_WQ_STACK
	int "Matter work queue stack, bytes"
	default 4096
	help
	  PROVISIONAL. Two stack sizes in this project were guessed low and both
	  faulted on hardware, so size this from CONFIG_THREAD_ANALYZER_AUTO
	  output rather than by estimate.

	  Raised from 2048 when PASE was wired up, because handling Pake1 is by
	  far the deepest thing this queue does: a 128-byte reply buffer, then
	  matter_pase_sm.c's frame holding pA, pB, Z and V (4 x 65 B) and a
	  SPAKE2+ result, then oberon's P-256 scalar multiplication underneath
	  all of it. That is an argument, not a measurement, which is exactly the
	  reasoning the note above says not to trust -- so measure it and trim.

config ULTRAWIDELOCK_MATTER_BLE_WQ_PRIO
	int "Matter work queue thread priority"
	default 10
	help
	  Must stay BELOW whatever arms the DW3110 reply. Stage 0 measured a CASE
	  handshake at 262.7 ms of solid CPU against a 0.66 ms FINAL->arm margin,
	  and ranging survived only because the load sat at a lower priority.

module = ULTRAWIDELOCK_MATTER_BLE
module-str = matter_ble
source "subsys/logging/Kconfig.template.log_config"

# The CLIENT logs separately from everything else Matter does, and that split is
# what makes a debug client image fit at all. matter_ble is the largest log
# module on the board; the client's own narration is a few dozen lines inside
# it. Sharing one level meant the only way to buy flash was to silence the very
# thing being brought up. See overlay-client-debug.conf.
module = ULTRAWIDELOCK_MATTER_CLIENT
module-str = matter_client
source "subsys/logging/Kconfig.template.log_config"

# THREAD logs separately for the same reason the client does. matter_thread_port.c
# and matter_dns_port.c narrate SRP registration and DNS-SD resolution, which is
# how "the bound lock did not resolve" gets diagnosed; matter_ble carries
# commissioning and fabric handling. Sharing one symbol meant neither could be
# turned down or up without the other.
module = ULTRAWIDELOCK_MATTER_THREAD
module-str = matter_thread
source "subsys/logging/Kconfig.template.log_config"

endif # ULTRAWIDELOCK_MATTER_BLE

config ULTRAWIDELOCK_BLE_CENTRAL
	bool "credential initiator BLE central transport (User-Device role)"
	depends on BT
	select BT_CENTRAL
	select BT_OBSERVER
	select BT_GATT_CLIENT
	select BT_L2CAP_DYNAMIC_CHANNEL
	default n
	help
	  The device half of the credential protocol, the role a phone plays, so a reader can be
	  exercised on the bench with no iPhone in the loop. Scans for the reader's
	  0xFFF2 advert, connects, reads the reader-SPSM characteristic, writes the
	  selected version and opens an L2CAP CoC client to the PSM that READ
	  returned. Zephyr mirror of the NimBLE backend in
	  ports/esp32/components/ultrawidelock_ble_central, behind the same
	  ultrawidelock_ble_central.h, so only the transport differs between the two ports.
	  A reader image does not want this. It exists so the initiator can be built
	  for a board carrying a DW3110, which the ESP32-S3 is not.
	  See ports/zephyr/ble/ultrawidelock_ble_central_zephyr.c.

config ULTRAWIDELOCK_THREAD_DATASET_DUMP
	bool "Print the active Thread operational dataset at attach (BENCH ONLY)"
	depends on OPENTHREAD
	default n
	help
	  Logs the active operational dataset as hex in the raw TLV form
	  `chip-tool pairing ble-thread` takes, when the commissioning window
	  opens -- an SW2 press, not every attach. Tying it to a gesture the
	  owner just made is deliberate; see admin_arm() in matter_commission.c.

	  THIS PRINTS THE THREAD NETWORK KEY IN THE CLEAR. Whoever reads that log
	  can join the network. It exists for one bench job: commissioning a second
	  Matter administrator over BLE, which needs a dataset argument, and the
	  only safe dataset to pass is the one the node is already on -- anything
	  else moves the node to a different network and takes it out of its home.

	  Default n and it must stay that way in anything that ships. There is no
	  runtime gate: a build either discloses the key on every attach or cannot.
