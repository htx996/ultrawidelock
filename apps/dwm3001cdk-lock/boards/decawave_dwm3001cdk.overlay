/*
 * DWM3001CDK standalone credential reader — board overlay.
 *
 * Declare the DW3110 that is already wired inside the DWM3001C module. &spi3 is
 * enabled by the board with CS on P1.06; only the side-band GPIOs are ours to
 * add. Pin values are cross-checked between the upstream Zephyr board files and
 * Qorvo's own uwb_stack_llhw.cmake (DW3_QM33_SDK 1.1.1), which agree on all of:
 *   SCK P0.03 · MOSI P0.08 · MISO P0.29 · CS P1.06
 *   IRQ P1.02 · RESETn P0.25 · WAKEUP P1.19
 *
 * NOTE ON PARTITIONS. This overlay deliberately does NOT touch the flash map.
 * The board's DTS carries an MCUboot dual-slot layout whose app slot is only
 * 0x38000 (224 KB), but NCS builds this with Partition Manager, which ignores
 * the DTS partitions entirely and derives its own map. With
 * CONFIG_BOOTLOADER_MCUBOOT=n Partition Manager derives a map. The shipping
 * lock enables MCUboot and pins its actual map in ../pm_static.yml:
 *
 *     app              0x0a200..0x74000
 *     patch_staging    0x74000..0x7c000    32 KB
 *     settings_storage 0x7c000..0x80000    16 KB
 *
 * Verified by building with and without a DTS partition override: partitions.yml
 * came out byte-identical both ways, as did the memory report. So a DTS override
 * here would be inert and would mislead the next reader into thinking the app
 * slot depends on it. pm_static.yml is the knob Partition Manager actually
 * reads.
 */

/*
 * Provisioning console. The DWM3001CDK's second USB port goes straight to the
 * nRF52833's device interface, so CDC-ACM is the board's only input path (RTT
 * is output-only and uart0 belongs to the J-Link OB's VCOM). The shell is bound
 * here rather than to uart0 so that plugging in that port is what reaches the
 * console. main() only calls usb_enable() in provisioning mode, so this node is
 * inert on an operational boot.
 */
&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/ {
	chosen {
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

&spi3 {
	dw3000: dw3000@0 {
		compatible = "decawave,dw3000";
		reg = <0>;
		/* The module's SPI trace is short and internal, but hold the first
		 * bring-up at the same 8 MHz the seated DWM3000EVB is proven at.
		 * Raise only with a DEV_ID read loop as evidence. */
		spi-max-frequency = <8000000>;
		reset-gpios  = <&gpio0 25 GPIO_ACTIVE_LOW>;
		irq-gpios    = <&gpio1  2 GPIO_ACTIVE_HIGH>;
		wakeup-gpios = <&gpio1 19 GPIO_ACTIVE_HIGH>;
	};
};

&gpio1 {
	status = "okay";
};
