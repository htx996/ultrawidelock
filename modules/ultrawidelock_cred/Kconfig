# UltraWideLock credential-auth stack — the open replacement for the closed
# libaliro/libaliro_ble reader engine. Shared by the ESP32-S3 port (where it is
# the only implementation) and, behind this option, the nRF5340 build.
#
# Distinct from ULTRAWIDELOCK_CRED in modules/ultrawidelock_uwb, which names the CCC/STS *ranging*
# engine below this layer and is unrelated.

config ULTRAWIDELOCK_CRED_STACK
	bool "UltraWideLock credential-auth stack (open libaliro replacement)"
	help
	  Compile the open credential reader core: the credential-auth key schedule
	  (X9.63/HKDF -> session keys, URSK, BleSK), the AES-256-GCM secure
	  channel, the BER-TLV/ISO7816 wire codec, and the reader trust store.

	  This builds the platform-agnostic core only. It provides no BLE
	  transport and does not displace libaliro on its own; the nRF5340 build
	  still links the closed archive.

config ULTRAWIDELOCK_CRED_DEV_TRUST
	bool "LAB ONLY: accept credentials with an empty dev trust store"
	help
	  Permit the built-in development identity to authenticate a presented
	  credential when no trust anchors exist. This bypass is for isolated lab
	  bring-up only. Production and release images must leave it disabled.

config ULTRAWIDELOCK_CRED_HOUSEKEEPING_STACK_SIZE
	int "Credential housekeeping thread stack size"
	depends on ULTRAWIDELOCK_CRED_STACK
	range 2048 8192
	default 3072
	help
	  Static stack, in bytes, for deferred P-256 spare generation and
	  provisioning persistence. Keep this low-priority worker large enough for
	  the selected crypto and settings backends; validate changes with target
	  stack instrumentation.

module = ULTRAWIDELOCK_CRED
module-str = ultrawidelock_cred
source "subsys/logging/Kconfig.template.log_config"
