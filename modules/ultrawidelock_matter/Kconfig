# Hand-written minimal Matter node. Distinct from the Nordic/CHIP Matter stack
# used by the Nordic door-lock integration and the ESP32 Matter app: this is the
# from-scratch implementation, and it exists because neither of those fits a
# 516 KB / 128 KB part alongside the reader.

config ULTRAWIDELOCK_MATTER
	bool "Hand-written minimal Matter node"
	# matter_crypto.c needs ultrawidelock_hash (SHA-256/HKDF) and the
	# crypto_aes_ecb_encrypt seam, whose backend choice in modules/ultrawidelock_uwb
	# is itself `depends on ULTRAWIDELOCK_CRED`. Nothing here re-implements either.
	depends on ULTRAWIDELOCK_CRED
	help
	  Compile the from-scratch Matter protocol code: TLV codec, message and
	  exchange layers, MRP, and the small cluster surface Apple Home
	  actually exercises.

	  This is NOT a certified Matter stack and does not aim to be. It exists
	  so a DWM3001CDK can receive its credential reader identity from Apple Home
	  over SetAliroReaderConfig, which is the only way this board can be
	  provisioned without cloning a credential from a donor.

	  Off by default; every stage lands behind it before anything depends
	  on it.

config ULTRAWIDELOCK_MATTER_CLIENT
	bool "Matter client: start CASE and send commands to another node"
	depends on ULTRAWIDELOCK_MATTER
	default n
	help
	  Compile the CASE INITIATOR: the half of the handshake this node needs
	  before it can send a command to another node on the fabric, rather
	  than only answer one.

	  This is what lets the lock unlock a SECOND lock directly when the UWB
	  gate fires -- the Matter binding pattern, with no hub automation in
	  the path. The node stays a full Door Lock server either way; the
	  client role is additive.

	  Off, not one byte of it is compiled: the sources live in their own
	  file, guarded in the CMakeLists rather than inside the code.
